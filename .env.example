# Copy this file to .env and fill in the first two. Everything else is
# optional - the defaults shown are what the bot uses when the line is missing.
#
# A variable set in your host's panel wins over this file, so on Wispbyte you
# can also skip the file and set them there.

# --- required ---------------------------------------------------------------

# Discord Developer Portal -> your application -> Bot -> Reset Token.
# The bot also needs the MESSAGE CONTENT INTENT switched on, on that same page.
DISCORD_TOKEN=

# The deobf server that does the actual work: the `web/` half of
# riftwarewtf/deobf, running somewhere this bot can reach over HTTP.
# `python web/server.py` in that repo, or its Dockerfile.
#
# The GitHub Pages site is NOT this: that one runs the pipeline inside the
# visitor's browser and has no API for a bot to call.
DEOBF_API=http://127.0.0.1:8000

# --- the server -------------------------------------------------------------

# Sent as `Authorization: Bearer <this>`. The deobf server has no
# authentication of its own, so this is only useful if you put it behind
# something that checks it (a reverse proxy, Cloudflare Access).
DEOBF_API_TOKEN=

# --- who can use it ---------------------------------------------------------

BOT_PREFIX=.

# Comma separated ids. Empty means "anywhere the bot can see".
ALLOWED_GUILDS=
ALLOWED_CHANNELS=
# These ids skip the cooldown, and are the only ones `.status` shows the
# server's address to.
OWNER_IDS=

# --- how much work is accepted ----------------------------------------------

# Jobs this bot will have on the server at once. The server has its own queue
# and its own limit; this only stops one bot from filling it.
MAX_INFLIGHT=4
# Largest script accepted, in bytes (12 MB). Lowered automatically if the
# server accepts less.
MAX_INPUT_BYTES=12582912
# Seconds the bot waits for one job before cancelling it on the server.
JOB_TIMEOUT=1800
# Seconds one person waits between requests (0 turns it off).
USER_COOLDOWN=10

# --- what the server is asked to do -----------------------------------------

# Hard timeout per run of the protected script, in seconds.
DEOB_TIMEOUT=90
# Soft time budget for the traced script, in seconds.
DEOB_BUDGET=30
# What identifyexecutor() tells the script it is running under.
DEOB_EXECUTOR=Wave

# 0 makes every request trace-only: much faster and far less memory on the
# server, but the output then only has the branches that actually ran.
DEVIRT=1

# --- the reply --------------------------------------------------------------

# Largest attachment the bot uploads, in bytes. Discord allows 10 MB on an
# unboosted server; anything over this is attached truncated.
MAX_UPLOAD_BYTES=9437184
# Lines of the result shown in the embed itself (0 for none).
PREVIEW_LINES=18
# Attach the server's pipeline log when a request fails.
ATTACH_LOG=1
# Embed colour while a request is running.
EMBED_COLOUR=0x5865F2

# INFO, or DEBUG when something is not behaving.
LOG_LEVEL=INFO
