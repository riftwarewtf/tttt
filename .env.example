# Copy this file to .env and fill in DISCORD_TOKEN. Everything else is
# optional - the defaults shown are what the bot uses when the line is missing.
#
# A variable set in your host's panel wins over this file, so on Wispbyte you
# can also skip the file and set them there.

# --- required ---------------------------------------------------------------

# Discord Developer Portal -> your application -> Bot -> Reset Token.
# The bot also needs the MESSAGE CONTENT INTENT switched on, on that same page.
#
# This is the only line that has to be filled in.
DISCORD_TOKEN=

# --- where the work happens -------------------------------------------------

# Empty (the default): the `deobf/` pipeline in this folder does the work, one
# subprocess per request. Nothing else to run.
#
# Set: that deobf server's HTTP API does it instead - the `web/` half of
# riftwarewtf/deobf, `python web/server.py` or its Dockerfile. Worth it when
# the box running the bot has less memory than lifting a big script wants
# (a few hundred MB), since then nothing heavy happens here at all.
#
# The GitHub Pages site is NOT such a server: it runs the pipeline inside the
# visitor's browser and has no API for a bot to call.
DEOBF_API=

# Sent as `Authorization: Bearer <this>`. A deobf server has no authentication
# of its own, so this is only useful if you put it behind something that checks
# it (a reverse proxy, Cloudflare Access).
DEOBF_API_TOKEN=

# --- who can use it ---------------------------------------------------------

BOT_PREFIX=.

# Comma separated ids. Empty means "anywhere the bot can see".
ALLOWED_GUILDS=
ALLOWED_CHANNELS=
# These ids skip the cooldown, and are the only ones `.status` shows a remote
# server's address to.
OWNER_IDS=

# --- how much work is accepted ----------------------------------------------

# Requests the bot works on at once. With DEOBF_API set this only stops one bot
# from filling the server's queue; the server has its own limit too.
MAX_INFLIGHT=4
# Local only: scripts deobfuscated at the same time on this machine. Each one
# can use a few hundred MB while lifting, so raise it only if there is memory
# for it. The rest wait, and their embeds say so.
MAX_CONCURRENCY=2
# Largest script accepted, in bytes (12 MB). Lowered automatically if a remote
# server accepts less.
MAX_INPUT_BYTES=12582912
# Seconds the bot waits for one job before giving up on it.
JOB_TIMEOUT=1800
# Seconds one person waits between requests (0 turns it off).
USER_COOLDOWN=10

# --- what the server is asked to do -----------------------------------------

# Hard timeout per run of the protected script, in seconds.
DEOB_TIMEOUT=90
# Soft time budget for the traced script, in seconds.
DEOB_BUDGET=30
# What identifyexecutor() tells the script it is running under.
DEOB_EXECUTOR=Wave

# 0 makes every request trace-only: much faster and far less memory, but the
# output then only has the branches that actually ran. Worth setting when the
# work happens here and the plan is a small one.
DEVIRT=1

# --- the reply --------------------------------------------------------------

# Largest attachment the bot uploads, in bytes. Discord allows 10 MB on an
# unboosted server; anything over this is attached truncated.
MAX_UPLOAD_BYTES=9437184
# Lines of the result shown in the embed itself (0 for none).
PREVIEW_LINES=18
# Attach the pipeline log when a request fails.
ATTACH_LOG=1
# Embed colour while a request is running.
EMBED_COLOUR=0x5865F2

# INFO, or DEBUG when something is not behaving.
LOG_LEVEL=INFO
